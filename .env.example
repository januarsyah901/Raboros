# Google Gemini API Key
# Dapatkan dari: https://aistudio.google.com/app/apikey
# Free tier: 20 requests per hari (auto reset 24 jam)
GEMINI_API_KEY=your_api_key_here

# MySQL Database Configuration
# HOST: localhost untuk local MySQL, atau IP address server
DB_HOST=localhost

# MySQL username (default: root)
DB_USER=root

# MySQL password (kosongkan jika tidak ada password)
DB_PASSWORD=

# Database name (akan dibuat otomatis saat npm run setup-db)
DB_NAME=raboros_db

# Express server port (jangan ganti kecuali ada konflik)
PORT=3001
